---
// SPDX-FileCopyrightText: 2026 AnmiTaliDev <anmitalidev@nuros.org>
// SPDX-License-Identifier: AGPL-3.0-only

interface Props {
  href: string;
  title: string;
  description: string;
  difficulty: "Intermediate" | "Advanced" | "Expert";
  icon: string;
}

const { href, title, description, difficulty, icon } = Astro.props;

const difficultyColor: Record<Props["difficulty"], string> = {
  Intermediate: "difficulty-green",
  Advanced: "difficulty-amber",
  Expert: "difficulty-red",
};
---

<a href={href} class="card">
  <div class="card-icon" aria-hidden="true">{icon}</div>
  <div class="card-body">
    <h2 class="card-title">{title}</h2>
    <p class="card-desc">{description}</p>
  </div>
  <div class="card-footer">
    <span class={`difficulty ${difficultyColor[difficulty]}`}>{difficulty}</span>
    <svg class="arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    color: inherit;
    text-decoration: none;
    transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
  }

  .card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .card-icon {
    font-size: 1.75rem;
    line-height: 1;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .card-body {
    flex: 1;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .difficulty {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
  }

  .difficulty-green {
    color: var(--green);
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.2);
  }

  .difficulty-amber {
    color: var(--amber);
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.2);
  }

  .difficulty-red {
    color: var(--red);
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.2);
  }

  .arrow {
    color: var(--text-muted);
    transition: transform var(--transition), color var(--transition);
  }

  .card:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }
</style>
